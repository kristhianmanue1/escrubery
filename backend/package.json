{
  "name": "backend",
  "version": "0.2.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "db:verificar": "node --env-file=.env --import tsx src/db/verificar.ts",
    "db:ingestar": "node --env-file=.env --import tsx src/db/ingestar.ts",
    "db:ingestar-help": "node --env-file=.env --import tsx src/db/ingestar_help.ts",
    "evidentia:probar-cadena": "node --env-file=.env --import tsx src/evidentia/probar_cadena.ts",
    "poller:github": "node --env-file=.env --import tsx src/evidentia/poller_github.ts",
    "poller:vmcp": "node --env-file=.env --import tsx src/evidentia/poller_vulnerable_mcp.ts",
    "keys:generar": "node --env-file=.env --import tsx src/evidentia/keys/generar_keypair.ts",
    "evidentia:firmar": "node --env-file=.env --import tsx src/evidentia/cli_firmar.ts",
    "evidentia:verificar": "node --env-file=.env --import tsx src/evidentia/cli_verificar.ts",
    "evidentia:alertas": "node --env-file=.env --import tsx src/evidentia/alertas.ts",
    "evidentia:probar-firma": "node --env-file=.env --import tsx src/evidentia/probar_firma.ts",
    "mcp:server": "node --env-file=.env --import tsx src/mcp/server.ts",
    "mcp:probar": "node --env-file=.env --import tsx src/mcp/probar_mcp.ts",
    "f3:introspectar": "node --env-file=.env --import tsx src/f3/sandbox_introspeccion.ts",
    "metricas:f1": "node --env-file=.env --import tsx src/metricas/f1.ts",
    "cli": "node --env-file=.env --import tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "kysely": "^0.29.4",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
