# Variables de entorno del backend — copiar a .env y ajustar.
# .env NO se commitea (ver .gitignore). Estos valores son ejemplos.

# Conexión a PostgreSQL.
# Local (peer auth sobre socket, sin password — typical Homebrew en macOS):
DATABASE_URL=postgresql:///escrubery?host=/tmp
# Docker (cuando se levante via docker compose up; ver docker-compose.yml):
# DATABASE_URL=postgresql://escrubery:escrubery@localhost:5432/escrubery

# Puerto del servidor Nest (Fase 1; el backend arranca con npm run start:dev).
PORT=3000
NODE_ENV=development

# F5 — auth HTTP /v0 (fail-closed: sin claves configuradas, todo responde 401).
# Claves = SHA-256 hex de la clave en claro, separadas por coma:
#   CLAVE=$(openssl rand -hex 24)
#   HASH=$(printf %s "$CLAVE" | shasum -a 256 | cut -d' ' -f1)
ESCRUBERY_API_KEYS=
# Límite de tasa por clave (req/min). Default 60.
ESCRUBERY_RATE_LIMIT_RPM=60
