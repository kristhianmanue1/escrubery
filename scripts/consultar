#!/usr/bin/env bash
# consultar — CLI de consulta (Fase 1 en adelante) sobre PostgreSQL.
# Wrapper: invoca el CLI Node (backend/src/cli.ts) directo (sin npm, para stdout puro),
# preservando la interfaz `consultar <op> <args>` con exit codes 0/1/2 (contrato v0).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT/backend"
exec node --env-file=.env --import tsx src/cli.ts "$@"
